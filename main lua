-- =====================================================================
-- AUDIO FOCUS
-- =====================================================================

local function requestAudioFocus()
  pcall(function()
    audioFocusManager = context.getSystemService(Context.AUDIO_SERVICE)

    if audioFocusManager == nil then
      return
    end

    if audioFocusListener == nil then
      audioFocusListener = AudioManager.OnAudioFocusChangeListener{
        onAudioFocusChange = function(focusChange)
          if focusChange == AudioManager.AUDIOFOCUS_LOSS then
            if player ~= nil and isPrepared then
              pcall(function()
                if player.isPlaying() then
                  player.pause()
                  isPlaying = false
                  updateButtons()
                  stopProgressUpdater()
                end
              end)
            end
          elseif focusChange == AudioManager.AUDIOFOCUS_LOSS_TRANSIENT then
            if player ~= nil and isPrepared then
              pcall(function()
                if player.isPlaying() then
                  player.pause()
                  isPlaying = false
                  updateButtons()
                  stopProgressUpdater()
                end
              end)
            end
          elseif focusChange == AudioManager.AUDIOFOCUS_GAIN then
            if player ~= nil and isPrepared and not isPlaying then
              pcall(function()
                player.start()
                isPlaying = true
                updateButtons()
                startProgressUpdater()
              end)
            end
          end
        end
      }
    end

    if Build.VERSION.SDK_INT >= 26 then
      local request = AudioFocusRequest.Builder(AudioManager.AUDIOFOCUS_GAIN)
        .setOnAudioFocusChangeListener(audioFocusListener)
        .setAudioAttributes(
          AudioAttributes.Builder()
            .setUsage(AudioAttributes.USAGE_MEDIA)
            .setContentType(AudioAttributes.CONTENT_TYPE_MUSIC)
            .build()
        )
        .build()
      audioFocusManager.requestAudioFocus(request)
    else
      audioFocusManager.requestAudioFocus(
        audioFocusListener,
        AudioManager.STREAM_MUSIC,
        AudioManager.AUDIOFOCUS_GAIN
      )
    end
  end)
end

local function abandonAudioFocus()
  pcall(function()
    if audioFocusManager ~= nil and audioFocusListener ~= nil then
      audioFocusManager.abandonAudioFocus(audioFocusListener)
    end
  end)
end

-- =====================================================================
-- WAKE LOCK
-- =====================================================================

local function acquireWakeLock()
  if not backgroundPlayback then
    return
  end

  pcall(function()
    if wakeLock == nil then
      local powerManager = context.getSystemService(Context.POWER_SERVICE)
      if powerManager ~= nil then
        wakeLock = powerManager.newWakeLock(
          PowerManager.PARTIAL_WAKE_LOCK,
          "HappyTooFriends::PlaybackLock"
        )
        wakeLock.setReferenceCounted(false)
      end
    end

    if wakeLock ~= nil and not wakeLock.isHeld() then
      wakeLock.acquire()
    end
  end)
end

local function releaseWakeLock()
  pcall(function()
    if wakeLock ~= nil and wakeLock.isHeld() then
      wakeLock.release()
    end
  end)
end

-- =====================================================================
-- EQUALIZER
-- =====================================================================

local function attachAudioEffects(sessionId)
  pcall(function()
    audioSessionId = sessionId

    if equalizer ~= nil then
      equalizer.release()
      equalizer = nil
    end

    if bassBoost ~= nil then
      bassBoost.release()
      bassBoost = nil
    end

    if sessionId ~= nil and sessionId ~= 0 then
      equalizer = Equalizer(0, sessionId)
      equalizer.setEnabled(getBoolean("eqEnabled", false))

      bassBoost = BassBoost(0, sessionId)
      bassBoost.setEnabled(getBoolean("bassEnabled", false))
      bassBoost.setStrength(tonumber(getInteger("bassStrength", 500)) or 500)
    end
  end)
end

local function releaseAudioEffects()
  pcall(function()
    if equalizer ~= nil then
      equalizer.setEnabled(false)
      equalizer.release()
    end
    equalizer = nil
  end)

  pcall(function()
    if bassBoost ~= nil then
      bassBoost.setEnabled(false)
      bassBoost.release()
    end
    bassBoost = nil
  end)
end

-- =====================================================================
-- PROGRESS UPDATER
-- =====================================================================

stopProgressUpdater = function()
  pcall(function()
    if progressHandler ~= nil and progressRunnable ~= nil then
      progressHandler.removeCallbacks(progressRunnable)
    end
  end)
  progressHandler = nil
  progressRunnable = nil
end

local function updateProgress()
  if player == nil or not isPrepared then
    return
  end

  if isSeeking then
    return
  end

  local position = 0
  local duration = 0

  pcall(function()
    position = player.getCurrentPosition()
    duration = player.getDuration()
  end)

  currentPosition = position
  currentDuration = duration

  pcall(function()
    if seekBar ~= nil and duration > 0 then
      seekBar.setMax(duration)
      seekBar.setProgress(position)
    end

    if positionView ~= nil then
      positionView.setText(formatTime(position))
    end

    if durationView ~= nil then
      durationView.setText(formatTime(duration))
    end
  end)

  if abRepeatA >= 0 and abRepeatB > abRepeatA then
    if position >= abRepeatB then
      pcall(function()
        player.seekTo(abRepeatA)
      end)
    end
  end
end

startProgressUpdater = function()
  stopProgressUpdater()

  progressHandler = Handler()

  progressRunnable = Runnable{
    run = function()
      updateProgress()

      pcall(function()
        if progressHandler ~= nil and progressRunnable ~= nil and isPlaying then
          progressHandler.postDelayed(progressRunnable, 500)
        end
      end)
    end
  }

  pcall(function()
    progressHandler.post(progressRunnable)
  end)
end

