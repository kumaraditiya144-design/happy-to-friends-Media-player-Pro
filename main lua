local function cycleSpeed()
  local speeds = {0.5, 0.75, 1.0, 1.25, 1.5, 1.75, 2.0, 2.5, 3.0}
  local currentPos = 3

  for i = 1, #speeds do
    if math.abs(speeds[i] - playbackSpeed) < 0.01 then
      currentPos = i
      break
    end
  end

  currentPos = currentPos + 1
  if currentPos > #speeds then
    currentPos = 1
  end

  playbackSpeed = speeds[currentPos]
  saveFloat("playbackSpeed", playbackSpeed)
  setPlaybackSpeed()
  updateButtons()
  toast(T("speed") .. ": " .. tostring(playbackSpeed) .. "x")
end

