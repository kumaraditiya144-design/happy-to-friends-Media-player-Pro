local prefs = context.getSharedPreferences(PREF_NAME, Context.MODE_PRIVATE)
local editor = prefs.edit()

local function saveString(key, value)
  pcall(function()
    editor.putString(tostring(key), tostring(value))
    editor.apply()
  end)
end

local function saveBoolean(key, value)
  pcall(function()
    editor.putBoolean(tostring(key), value == true)
    editor.apply()
  end)
end

local function saveInteger(key, value)
  pcall(function()
    editor.putInt(tostring(key), tonumber(value) or 0)
    editor.apply()
  end)
end

local function saveFloat(key, value)
  pcall(function()
    editor.putFloat(tostring(key), tonumber(value) or 1)
    editor.apply()
  end)
end

local function getString(key, defaultValue)
  local value = defaultValue
  pcall(function()
    value = prefs.getString(tostring(key), tostring(defaultValue))
  end)
  return value
end

local function getBoolean(key, defaultValue)
  local value = defaultValue
  pcall(function()
    value = prefs.getBoolean(tostring(key), defaultValue)
  end)
  return value
end

local function getInteger(key, defaultValue)
  local value = defaultValue
  pcall(function()
    value = prefs.getInt(tostring(key), defaultValue)
  end)
  return value
end

local function getFloat(key, defaultValue)
  local value = defaultValue
  pcall(function()
    value = prefs.getFloat(tostring(key), defaultValue)
  end)
  return value
end

local function removeKey(key)
  pcall(function()
    editor.remove(tostring(key))
    editor.apply()
  end)
end

