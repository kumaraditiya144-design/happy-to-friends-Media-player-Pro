local function applySorting()
  if sortMode == "Title" then
    table.sort(audioList, function(a, b)
      return normalize(a.title) < normalize(b.title)
    end)
  elseif sortMode == "Artist" then
    table.sort(audioList, function(a, b)
      local aa = normalize(a.artist)
      local ab = normalize(b.artist)
      if aa == ab then
        return normalize(a.title) < normalize(b.title)
      end
      return aa < ab
    end)
  elseif sortMode == "Duration" then
    table.sort(audioList, function(a, b)
      return (a.duration or 0) < (b.duration or 0)
    end)
  elseif sortMode == "Date" then
    table.sort(audioList, function(a, b)
      return (a.dateAdded or 0) > (b.dateAdded or 0)
    end)
  end
end

local function scanAudioFiles()
  audioList = {}
  visibleList = {}

  local cursor = nil

  pcall(function()
    local resolver = context.getContentResolver()
    local uri = MediaStore.Audio.Media.EXTERNAL_CONTENT_URI

    local projection = {
      MediaStore.Audio.Media.DATA,
      MediaStore.Audio.Media.TITLE,
      MediaStore.Audio.Media.ARTIST,
      MediaStore.Audio.Media.DURATION,
      MediaStore.Audio.Media.DATE_ADDED,
      MediaStore.Audio.Media.ALBUM
    }

    cursor = resolver.query(
      uri,
      projection,
      MediaStore.Audio.Media.IS_MUSIC .. " != 0",
      nil,
      nil
    )

    if cursor ~= nil then
      local pathColumn = cursor.getColumnIndex(MediaStore.Audio.Media.DATA)
      local titleColumn = cursor.getColumnIndex(MediaStore.Audio.Media.TITLE)
      local artistColumn = cursor.getColumnIndex(MediaStore.Audio.Media.ARTIST)
      local durationColumn = cursor.getColumnIndex(MediaStore.Audio.Media.DURATION)
      local dateColumn = cursor.getColumnIndex(MediaStore.Audio.Media.DATE_ADDED)
      local albumColumn = cursor.getColumnIndex(MediaStore.Audio.Media.ALBUM)

      while cursor.moveToNext() do
        local path = cursor.getString(pathColumn)
        local title = cursor.getString(titleColumn)
        local artist = cursor.getString(artistColumn)
        local duration = cursor.getLong(durationColumn)
        local dateAdded = cursor.getLong(dateColumn)
        local album = cursor.getString(albumColumn)

        if path ~= nil and fileExists(path) and isAudioFile(path) then
          table.insert(audioList, {
            path = tostring(path),
            title = tostring(title or removeExtension(getFileName(path))),
            artist = tostring(artist or ""),
            album = tostring(album or ""),
            duration = tonumber(duration or 0) or 0,
            dateAdded = tonumber(dateAdded or 0) or 0
          })
        end
      end
    end
  end)

  pcall(function()
    if cursor ~= nil then
      cursor.close()
    end
  end)

  applySorting()

  for i = 1, #audioList do
    table.insert(visibleList, audioList[i])
  end

  local lastPath = getString("lastPath", "")

  if lastPath ~= "" then
    for i = 1, #visibleList do
      if visibleList[i].path == lastPath then
        currentIndex = i
        currentPath = visibleList[i].path
        currentTitle = visibleList[i].title
        break
      end
    end
  end
end

local function filterAudio(query)
  query = normalize(query)
  visibleList = {}

  local sourceList = audioList

  if showRecentlyPlayed then
    sourceList = recentlyPlayed
  end

  for i = 1, #sourceList do
    local item = sourceList[i]
    local matched = false

    if query == "" then
      matched = true
    elseif normalize(item.title):find(query, 1, true) then
      matched = true
    elseif normalize(item.artist):find(query, 1, true) then
      matched = true
    elseif normalize(item.path):find(query, 1, true) then
      matched = true
    end

    if showFavoritesOnly then
      matched = matched and isFavorite(item.path)
    end

    if matched then
      table.insert(visibleList, item)
    end
  end
end

local function refreshListAdapter()
  if listView == nil then
    return
  end

  local names = ArrayList()

  for i = 1, #visibleList do
    local item = visibleList[i]
    local text = item.title

    if isFavorite(item.path) then
      text = "★ " .. text
    end

    if showMetadata then
      local details = {}

      if item.artist ~= "" and item.artist ~= "<unknown>" then
        table.insert(details, item.artist)
      end

      if item.duration and item.duration > 0 then
        table.insert(details, formatTime(item.duration))
      end

      if #details > 0 then
        text = text .. "\n" .. table.concat(details, " • ")
      end
    end

    names.add(text)
  end

  local adapter = ArrayAdapter(
    context,
    android.R.layout.simple_list_item_1,
    names
  )

  listView.setAdapter(adapter)
end

