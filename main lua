local function shareAudio(path)
  if path == nil then
    return
  end

  pcall(function()
    local file = File(path)
    local uri = Uri.fromFile(file)
    local intent = Intent(Intent.ACTION_SEND)

    intent.setType("audio/*")
    intent.putExtra(Intent.EXTRA_STREAM, uri)
    intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)

    context.startActivity(Intent.createChooser(intent, T("share")))
  end)
end

local function renameAudio(item)
  if item == nil or item.path == nil then
    return
  end

  local oldFile = File(item.path)
  local oldName = oldFile.getName()
  local extension = oldName:match("(%.[^%.]+)$") or ""
  local defaultName = removeExtension(oldName)

  local input = EditText(context)
  input.setText(defaultName)
  input.setSelectAllOnFocus(true)

  local layout = LinearLayout(context)
  layout.setOrientation(LinearLayout.VERTICAL)
  layout.setPadding(dp(20), dp(10), dp(20), dp(10))
  layout.addView(input)

  local dialog = AlertDialog.Builder(context)
    .setTitle(T("rename"))
    .setMessage(T("enterName"))
    .setView(layout)
    .setNegativeButton(T("cancel"), nil)
    .setPositiveButton(T("save"), {
      onClick = function()
        local newName = tostring(input.getText())

        if newName == "" then
          return
        end

        if not newName:match("%.[^%.]+$") then
          newName = newName .. extension
        end

        local parent = oldFile.getParentFile()
        local newFile = File(parent, newName)

        if newFile.exists() then
          toast("A file with this name already exists")
          return
        end

        local success = false

        pcall(function()
          success = oldFile.renameTo(newFile)
        end)

        if success then
          if currentPath == item.path then
            currentPath = newFile.getAbsolutePath()
            saveString("lastPath", currentPath)
          end

          scanAudioFiles()
          filterAudio(searchEdit and tostring(searchEdit.getText()) or "")
          refreshListAdapter()
          toast(T("songRenamed"))
        else
          toast("Rename failed")
        end
      end
    })
    .create()

  showDialogSafely(dialog)
end

local function deleteAudio(item)
  if item == nil or item.path == nil then
    return
  end

  local function performDelete()
    local success = false

    pcall(function()
      success = File(item.path).delete()
    end)

    if success then
      if currentPath == item.path then
        releasePlayer()
        currentPath = nil
        currentTitle = nil
      end

      clearSavedPositionForPath(item.path)
      setFavorite(item.path, false)

      scanAudioFiles()
      filterAudio(searchEdit and tostring(searchEdit.getText()) or "")
      refreshListAdapter()
      updateNowPlaying()
      toast(T("songDeleted"))
    else
      toast("Delete failed")
    end
  end

  if not confirmDelete then
    performDelete()
    return
  end

  local dialog = AlertDialog.Builder(context)
    .setTitle(T("delete"))
    .setMessage(T("confirmDeleteText"))
    .setNegativeButton(T("no"), nil)
    .setPositiveButton(T("yes"), {
      onClick = function()
        performDelete()
      end
    })
    .create()

  showDialogSafely(dialog)
end

local function toggleFavorite(item)
  if item == nil then
    return
  end

  local newValue = not isFavorite(item.path)
  setFavorite(item.path, newValue)

  if newValue then
    toast(T("favoriteAdded"))
  else
    toast(T("favoriteRemoved"))
  end

  filterAudio(searchEdit and tostring(searchEdit.getText()) or "")
  refreshListAdapter()
end

local function addItemToQueue(item, playNextInQueue)
  if item == nil then
    return
  end

  local entry = {
    path = item.path,
    title = item.title,
    artist = item.artist,
    duration = item.duration
  }

  if playNextInQueue then
    table.insert(queue, 1, entry)
    toast(T("addedToPlayNext"))
  else
    table.insert(queue, entry)
    toast(T("addedToQueue"))
  end
end

local function showItemMenu(item)
  if item == nil then
    return
  end

  local favoriteText = T("addFavorite")
  if isFavorite(item.path) then
    favoriteText = T("removeFavorite")
  end

  local options = {
    T("play"),
    T("playNext"),
    T("addToQueue"),
    favoriteText,
    T("rename"),
    T("delete"),
    T("share"),
    T("information"),
    T("cancel")
  }

  local dialog = AlertDialog.Builder(context)
    .setTitle(item.title)
    .setItems(options, {
      onClick = function(dialogObject, which)
        if which == 0 then
          for i = 1, #visibleList do
            if visibleList[i].path == item.path then
              playItem(i)
              break
            end
          end
        elseif which == 1 then
          addItemToQueue(item, true)
        elseif which == 2 then
          addItemToQueue(item, false)
        elseif which == 3 then
          toggleFavorite(item)
        elseif which == 4 then
          renameAudio(item)
        elseif which == 5 then
          deleteAudio(item)
        elseif which == 6 then
          shareAudio(item.path)
        elseif which == 7 then
          showAudioInfo(item)
        end
      end
    })
    .create()

  showDialogSafely(dialog)
end

