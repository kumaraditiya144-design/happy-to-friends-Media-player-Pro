local function cycleABRepeat()
  if player == nil or not isPrepared then
    toast(T("noAudio"))
    return
  end

  local position = 0
  pcall(function()
    position = player.getCurrentPosition()
  end)

  if abRepeatA < 0 then
    abRepeatA = position
    abRepeatB = -1
    toast(T("abSetA") .. ": " .. formatTime(position))
  elseif abRepeatB < 0 then
    if position <= abRepeatA then
      toast("B must be after A")
      return
    end
    abRepeatB = position
    toast(T("abSetB") .. ": " .. formatTime(position) .. " - " .. T("abActive"))
  else
    abRepeatA = -1
    abRepeatB = -1
    toast(T("abClear"))
  end

  updateButtons()
end

