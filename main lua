-- =====================================================================

local function cancelSleepTimer()
  pcall(function()
    if sleepHandler ~= nil and sleepRunnable ~= nil then
      sleepHandler.removeCallbacks(sleepRunnable)
    end
  end)

  sleepHandler = nil
  sleepRunnable = nil
  sleepTimerMinutes = 0
  saveInteger("sleepTimerMinutes", 0)
end

local function setSleepTimer(minutes)
  cancelSleepTimer()

  minutes = tonumber(minutes) or 0

  if minutes <= 0 then
    toast(T("sleepDisabled"))
    return
  end

  sleepTimerMinutes = minutes
  saveInteger("sleepTimerMinutes", minutes)

  sleepHandler = Handler()

  sleepRunnable = Runnable{
    run = function()
      pcall(function()
        if player ~= nil and isPrepared then
          local steps = 10
          for i = steps, 1, -1 do
            local vol = i / steps
            pcall(function()
              player.setVolume(vol, vol)
            end)
            Thread.sleep(50)
          end
        end
      end)

      stopCurrent()

      pcall(function()
        if player ~= nil then
          player.setVolume(1.0, 1.0)
        end
      end)

      cancelSleepTimer()
      toast(T("sleepTimerFinished"))
    end
  }

  pcall(function()
    sleepHandler.postDelayed(sleepRunnable, minutes * 60 * 1000)
  end)

  toast(T("sleepTimer") .. ": " .. tostring(minutes) .. " " .. T("minutes"))
end

