local function getFavoriteKey(path)
  return "favorite_" .. tostring(path or "")
end

local function isFavorite(path)
  return getBoolean(getFavoriteKey(path), false)
end

local function setFavorite(path, value)
  saveBoolean(getFavoriteKey(path), value)
end

local function addToRecentlyPlayed(item)
  if item == nil or item.path == nil then
    return
  end

  for i = #recentlyPlayed, 1, -1 do
    if recentlyPlayed[i].path == item.path then
      table.remove(recentlyPlayed, i)
    end
  end

  table.insert(recentlyPlayed, 1, {
    path = item.path,
    title = item.title,
    artist = item.artist,
    duration = item.duration
  })

  while #recentlyPlayed > recentlyPlayedLimit do
    table.remove(recentlyPlayed)
  end
end

local function savePositionForPath(path)
  if path == nil or player == nil or not isPrepared then
    return
  end

  pcall(function()
    local pos = player.getCurrentPosition()
    if pos > 1000 then
      saveInteger("position_" .. path, pos)
    end
  end)
end

local function getSavedPositionForPath(path)
  if path == nil then
    return 0
  end
  return getInteger("position_" .. path, 0)
end

local function clearSavedPositionForPath(path)
  if path == nil then
    return
  end
  removeKey("position_" .. path)
end

releasePlayer = function()
  stopProgressUpdater()

  savePositionForPath(currentPath)

  releaseAudioEffects()
  releaseWakeLock()

  pcall(function()
    if player ~= nil then
      player.stop()
    end
  end)

  pcall(function()
    if player ~= nil then
      player.reset()
      player.release()
    end
  end)

  player = nil
  isPrepared = false
  isPlaying = false
  currentDuration = 0
  currentPosition = 0
end

loadAndPlayPath = function(path, title, index)
  if path == nil or path == "" then
    toast(T("noAudio"))
    return
  end

  if not fileExists(path) then
    toast(T("errorNoFile"))
    return
  end

  releasePlayer()

  currentPath = path
  currentTitle = title
  currentIndex = index or 0
  currentPosition = 0
  abRepeatA = -1
  abRepeatB = -1

  saveString("lastPath", path)
  saveInteger("lastIndex", currentIndex)

  player = MediaPlayer()

  pcall(function()
    player.setAudioStreamType(AudioManager.STREAM_MUSIC)
  end)

  pcall(function()
    player.setOnPreparedListener{
      onPrepared = function(mp)
        isPrepared = true
        isPlaying = true

        pcall(function()
          currentDuration = mp.getDuration()
        end)

        setPlaybackSpeed()

        local sessionId = 0

        pcall(function()
          sessionId = mp.getAudioSessionId()
        end)

        attachAudioEffects(sessionId)

        if resumePlayback then
          local savedPosition = getSavedPositionForPath(currentPath)
          if savedPosition > 3000 and savedPosition < currentDuration - 3000 then
            pcall(function()
              mp.seekTo(savedPosition)
            end)
          end
        end

        pcall(function()
          mp.start()
        end)

        requestAudioFocus()
        acquireWakeLock()
        updateButtons()
        updateNowPlaying()
        startProgressUpdater()

        addToRecentlyPlayed({
          path = currentPath,
          title = currentTitle,
          artist = "",
          duration = currentDuration
        })

        toast(T("playing") .. ": " .. tostring(currentTitle or ""))
      end
    }
  end)

  pcall(function()
    player.setOnCompletionListener{
      onCompletion = function(mp)
        isPlaying = false
        stopProgressUpdater()
        clearSavedPositionForPath(currentPath)

        if repeatMode == "ONE" then
          pcall(function()
            mp.seekTo(0)
            mp.start()
            isPlaying = true
            startProgressUpdater()
            updateButtons()
          end)
        elseif autoNext then
          if #queue > 0 then
            local nextItem = table.remove(queue, 1)
            loadAndPlayPath(nextItem.path, nextItem.title, 0)
          else
            playNext()
          end
        else
          updateButtons()
        end
      end
    }
  end)

  pcall(function()
    player.setOnErrorListener{
      onError = function(mp, what, extra)
        isPrepared = false
        isPlaying = false
        stopProgressUpdater()
        releaseWakeLock()
        toast(T("playbackError") .. ": " .. tostring(what))
        return true
      end
    }
  end)

  pcall(function()
    player.setDataSource(path)
    player.prepareAsync()
  end)
end

playNext = function()
  if #queue > 0 then
    local nextItem = table.remove(queue, 1)
    loadAndPlayPath(nextItem.path, nextItem.title, 0)
    return
  end

  if #visibleList == 0 then
    return
  end

  local nextIndex

  if shuffleEnabled then
    math.randomseed(os.time() + math.random(1, 1000))
    nextIndex = math.random(1, #visibleList)
  else
    nextIndex = currentIndex + 1
    if nextIndex > #visibleList then
      if repeatMode == "ALL" then
        nextIndex = 1
      else
        nextIndex = #visibleList
      end
    end
  end

  local item = visibleList[nextIndex]

  if item ~= nil then
    currentIndex = nextIndex
    loadAndPlayPath(item.path, item.title, nextIndex)
  end
end

playPrevious = function()
  if #visibleList == 0 then
    return
  end

  if player ~= nil and isPrepared then
    local position = 0
    pcall(function()
      position = player.getCurrentPosition()
    end)

    if position > 5000 then
      pcall(function()
        player.seekTo(0)
      end)
      return
    end
  end

  local previousIndex = currentIndex - 1

  if previousIndex < 1 then
    previousIndex = #visibleList
  end

  local item = visibleList[previousIndex]
  if item ~= nil then
    currentIndex = previousIndex
    loadAndPlayPath(item.path, item.title, previousIndex)
  end
end

playCurrent = function()
  if currentPath == nil then
    toast(T("noAudio"))
    return
  end

  if player ~= nil and isPrepared then
    pcall(function()
      if player.isPlaying() then
        player.pause()
        isPlaying = false
        savePositionForPath(currentPath)
        stopProgressUpdater()
        releaseWakeLock()
        toast(T("paused"))
      else
        player.start()
        isPlaying = true
        requestAudioFocus()
        acquireWakeLock()
        startProgressUpdater()
        toast(T("playing"))
      end
    end)

    updateButtons()
  else
    loadAndPlayPath(currentPath, currentTitle, currentIndex)
  end
end

playItem = function(index)
  if index == nil or index < 1 or index > #visibleList then
    return
  end

  local item = visibleList[index]

  if item == nil then
    return
  end

  currentIndex = index
  loadAndPlayPath(item.path, item.title, index)
end

stopCurrent = function()
  pcall(function()
    if player ~= nil and isPrepared then
      player.stop()
    end
  end)

  savePositionForPath(currentPath)
  isPrepared = false
  isPlaying = false
  stopProgressUpdater()
  releaseWakeLock()
  releaseAudioEffects()
  updateButtons()
  toast(T("stopped"))
end

local function seekRelative(milliseconds)
  if player == nil or not isPrepared then
    return
  end

  local position = 0
  local duration = 0

  pcall(function()
    position = player.getCurrentPosition()
    duration = player.getDuration()
  end)

  local newPosition = position + milliseconds

  if newPosition < 0 then
    newPosition = 0
  end

  if duration > 0 and newPosition > duration then
    newPosition = duration
  end

  pcall(function()
