local function dp(value)
  local density = 1
  pcall(function()
    density = context.getResources().getDisplayMetrics().density
  end)
  return math.floor((tonumber(value) or 0) * density + 0.5)
end

local function speak(text)
  pcall(function()
    if service and service.speak then
      service.speak(tostring(text))
    elseif service and service.tts then
      service.tts.speak(tostring(text))
    end
  end)
end

local function toast(text)
  pcall(function()
    Toast.makeText(context, tostring(text), Toast.LENGTH_SHORT).show()
  end)
  speak(text)
end

local function normalize(value)
  return tostring(value or ""):lower()
end

local function getFileName(path)
  local name = tostring(path or ""):match("([^/]+)$")
  return name or tostring(path or "")
end

local function removeExtension(name)
  return tostring(name or ""):gsub("%.[^%.]+$", "")
end

local function formatTime(milliseconds)
  local ms = tonumber(milliseconds) or 0

  if ms < 0 then
    ms = 0
  end

  local seconds = math.floor(ms / 1000)
  local hours = math.floor(seconds / 3600)
  local minutes = math.floor((seconds % 3600) / 60)
  local remaining = seconds % 60

  if hours > 0 then
    return string.format("%02d:%02d:%02d", hours, minutes, remaining)
  end

  return string.format("%02d:%02d", minutes, remaining)
end

local function fileExists(path)
  local result = false
  pcall(function()
    result = File(tostring(path)).exists()
  end)
  return result
end

local function isAudioFile(path)
  local extension = tostring(path or ""):lower():match("%.([^%.]+)$")

  local supported = {
    mp3 = true, wav = true, m4a = true, aac = true,
    ogg = true, opus = true, flac = true, amr = true,
    ["3gp"] = true, mid = true, midi = true, wma = true,
    mp4 = true, mka = true
  }

  return extension ~= nil and supported[extension] == true
end

local function showDialogSafely(dialog)
  if dialog == nil then
    return false
  end

  local shown = false

  pcall(function()
    local window = dialog.getWindow()
    if window ~= nil then
      if Build.VERSION.SDK_INT >= 26 then
        window.setType(WindowManager.LayoutParams.TYPE_ACCESSIBILITY_OVERLAY)
      else
        window.setType(WindowManager.LayoutParams.TYPE_PHONE)
      end
    end
  end)

  pcall(function()
    dialog.show()
    shown = true
  end)

  if not shown then
    pcall(function()
      dialog.getWindow().setType(WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY)
      dialog.show()
      shown = true
    end)
  end

  return shown
end

