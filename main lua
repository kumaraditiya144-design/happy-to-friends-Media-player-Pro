      onClick = function()
        local selectedTheme = themeSpinner.getSelectedItemPosition()
        if selectedTheme == 0 then
          currentTheme = "System"
        elseif selectedTheme == 1 then
          currentTheme = "Light"
        else
          currentTheme = "Dark"
        end

        local selectedSort = sortSpinner.getSelectedItemPosition()
        if selectedSort == 0 then
          sortMode = "Title"
        elseif selectedSort == 1 then
          sortMode = "Artist"
        elseif selectedSort == 2 then
          sortMode = "Duration"
        else
          sortMode = "Date"
        end

        local skipValues = {5, 10, 15, 30, 60}
        skipSeconds = skipValues[skipSpinner.getSelectedItemPosition() + 1] or 10

        playbackSpeed = speedValuesList[speedSpinner.getSelectedItemPosition() + 1] or 1.0

        local repeatValues = {"OFF", "ALL", "ONE"}
        repeatMode = repeatValues[repeatSpinner.getSelectedItemPosition() + 1] or "OFF"

        shuffleEnabled = shuffleCheck.isChecked()
        autoNext = autoNextCheck.isChecked()
        resumePlayback = resumeCheck.isChecked()
        showMetadata = metadataCheck.isChecked()
        confirmDelete = deleteCheck.isChecked()
        backgroundPlayback = backgroundCheck.isChecked()

        sleepTimerMinutes = sleepValues[sleepSpinner.getSelectedItemPosition() + 1] or 0

        local eqEnabled = eqCheck.isChecked()
        local bassEnabled = bassCheck.isChecked()
        local bassStrength = bassBar.getProgress()

        saveString("theme", currentTheme)
        saveString("sortMode", sortMode)
        saveInteger("skipSeconds", skipSeconds)
        saveFloat("playbackSpeed", playbackSpeed)
        saveString("repeatMode", repeatMode)
        saveBoolean("shuffleEnabled", shuffleEnabled)
        saveBoolean("autoNext", autoNext)
        saveBoolean("resumePlayback", resumePlayback)
        saveBoolean("confirmDelete", confirmDelete)
        saveBoolean("showMetadata", showMetadata)
        saveBoolean("backgroundPlayback", backgroundPlayback)
        saveInteger("sleepTimerMinutes", sleepTimerMinutes)
        saveBoolean("eqEnabled", eqEnabled)
        saveBoolean("bassEnabled", bassEnabled)
        saveInteger("bassStrength", bassStrength)

        pcall(function()
          if equalizer ~= nil then
            equalizer.setEnabled(eqEnabled)

            for i = 0, bandCount - 1 do
              local entry = bandSeekBars[i]
              if entry ~= nil then
                local level = entry.bar.getProgress() + minLevel
                equalizer.setBandLevel(i, level)
              end
            end
          end
        end)

        pcall(function()
          if bassBoost ~= nil then
            bassBoost.setEnabled(bassEnabled)
            bassBoost.setStrength(bassStrength)
          end
        end)

        if sleepTimerMinutes > 0 then
          setSleepTimer(sleepTimerMinutes)
        else
          cancelSleepTimer()
        end

        setPlaybackSpeed()
        applySorting()
        scanAudioFiles()
        filterAudio(searchEdit and tostring(searchEdit.getText()) or "")
        updateButtons()
        refreshListAdapter()
        toast(T("settingsSaved"))
      end
    })
    .create()

  showDialogSafely(settingsDialog)
end

-- =====================================================================
-- MAIN DIALOG
-- =====================================================================

local function showMainDialog()
  scanAudioFiles()

  local root = LinearLayout(context)
  root.setOrientation(LinearLayout.VERTICAL)
  root.setPadding(dp(12), dp(8), dp(12), dp(8))

  local heading = TextView(context)
  heading.setText(APP_NAME)
  heading.setTextSize(18)
  heading.setGravity(Gravity.CENTER)
  root.addView(heading)

  local devView = TextView(context)
  devView.setText(DEVELOPER)
  devView.setTextSize(12)
  devView.setGravity(Gravity.CENTER)
  root.addView(devView)

  titleView = TextView(context)
  titleView.setText(currentTitle or APP_NAME)
  titleView.setTextSize(16)
  titleView.setGravity(Gravity.CENTER)
  root.addView(titleView)

  subtitleView = TextView(context)
  subtitleView.setText("")
  subtitleView.setGravity(Gravity.CENTER)
  root.addView(subtitleView)

  local controlLayout = LinearLayout(context)
  controlLayout.setOrientation(LinearLayout.VERTICAL)

  local firstRow = LinearLayout(context)
  firstRow.setOrientation(LinearLayout.HORIZONTAL)

  local previousButton = createButton(T("previous"), function()
    playPrevious()
  end)

  playButton = createButton(T("play"), function()
    playCurrent()
  end)

  local nextButton = createButton(T("next"), function()
    playNext()
  end)

  firstRow.addView(previousButton, LinearLayout.LayoutParams(0, -2, 1))
  firstRow.addView(playButton, LinearLayout.LayoutParams(0, -2, 1))
  firstRow.addView(nextButton, LinearLayout.LayoutParams(0, -2, 1))
  controlLayout.addView(firstRow)

  local secondRow = LinearLayout(context)
  secondRow.setOrientation(LinearLayout.HORIZONTAL)

  local rewindButton = createButton("<< " .. tostring(skipSeconds) .. "s", function()
    seekRelative(-skipSeconds * 1000)
  end)

  local stopButton = createButton(T("stop"), function()
    stopCurrent()
  end)

  local forwardButton = createButton(tostring(skipSeconds) .. "s >>", function()
    seekRelative(skipSeconds * 1000)
  end)

  secondRow.addView(rewindButton, LinearLayout.LayoutParams(0, -2, 1))
  secondRow.addView(stopButton, LinearLayout.LayoutParams(0, -2, 1))
  secondRow.addView(forwardButton, LinearLayout.LayoutParams(0, -2, 1))
  controlLayout.addView(secondRow)

  seekBar = SeekBar(context)
  seekBar.setMax(1000)

  seekBar.setOnSeekBarChangeListener{
    onProgressChanged = function(bar, progress, fromUser)
      if fromUser then
        if positionView ~= nil then
          local duration = 0
          pcall(function()
            if player ~= nil then
              duration = player.getDuration()
            end
          end)

          if duration > 0 then
            positionView.setText(formatTime(math.floor(duration * progress / 1000)))
          end
        end
      end
    end,

    onStartTrackingTouch = function(bar)
      isSeeking = true
    end,

    onStopTrackingTouch = function(bar)
      if player ~= nil and isPrepared then
        local duration = 0
        pcall(function()
          duration = player.getDuration()
        end)

        if duration > 0 then
          local newPosition = math.floor(duration * bar.getProgress() / 1000)
          pcall(function()
            player.seekTo(newPosition)
          end)
        end
      end

      isSeeking = false
    end
  }

  controlLayout.addView(seekBar)

  local timeRow = LinearLayout(context)
  timeRow.setOrientation(LinearLayout.HORIZONTAL)

  positionView = TextView(context)
  positionView.setText("00:00")

  durationView = TextView(context)
  durationView.setText("00:00")
  durationView.setGravity(Gravity.RIGHT)

  timeRow.addView(positionView, LinearLayout.LayoutParams(0, -2, 1))
  timeRow.addView(durationView, LinearLayout.LayoutParams(0, -2, 1))
  controlLayout.addView(timeRow)

  local thirdRow = LinearLayout(context)
  thirdRow.setOrientation(LinearLayout.HORIZONTAL)

  repeatButton = createButton(T("repeat") .. ": " .. repeatMode, function()
    cycleRepeat()
  end)

  shuffleButton = createButton(T("shuffle"), function()
    cycleShuffle()
  end)

  speedButton = createButton(T("speed"), function()
    cycleSpeed()
  end)

  thirdRow.addView(repeatButton, LinearLayout.LayoutParams(0, -2, 1))
  thirdRow.addView(shuffleButton, LinearLayout.LayoutParams(0, -2, 1))
  thirdRow.addView(speedButton, LinearLayout.LayoutParams(0, -2, 1))
  controlLayout.addView(thirdRow)

  local fourthRow = LinearLayout(context)
  fourthRow.setOrientation(LinearLayout.HORIZONTAL)

  abButton = createButton("A-B", function()
    cycleABRepeat()
  end)

  local queueButton = createButton(T("viewQueue"), function()
    showQueueDialog()
  end)

  fourthRow.addView(abButton, LinearLayout.LayoutParams(0, -2, 1))
  fourthRow.addView(queueButton, LinearLayout.LayoutParams(0, -2, 2))
  controlLayout.addView(fourthRow)

  root.addView(controlLayout)

  local searchRow = LinearLayout(context)
  searchRow.setOrientation(LinearLayout.HORIZONTAL)

  searchEdit = EditText(context)
  searchEdit.setHint(T("search"))
  searchEdit.setSingleLine(true)

  local searchButton = createButton(T("search"), function()
    filterAudio(tostring(searchEdit.getText()))
    refreshListAdapter()
  end)

  searchRow.addView(searchEdit, LinearLayout.LayoutParams(0, -2, 1))
  searchRow.addView(searchButton, LinearLayout.LayoutParams(-2, -2))
  root.addView(searchRow)

  local filterRow = LinearLayout(context)
  filterRow.setOrientation(LinearLayout.HORIZONTAL)

  local allButton = createButton(T("allSongs"), function()
    showFavoritesOnly = false
    showRecentlyPlayed = false
    filterAudio(tostring(searchEdit.getText()))
    refreshListAdapter()
  end)

  local favoriteButton = createButton(T("favorites"), function()
    showFavoritesOnly = true
    showRecentlyPlayed = false
    filterAudio(tostring(searchEdit.getText()))
    refreshListAdapter()

    if #visibleList == 0 then
      toast(T("noFavorites"))
    end
  end)

  local recentButton = createButton(T("recentlyPlayed"), function()
    showFavoritesOnly = false
    showRecentlyPlayed = true
    filterAudio(tostring(searchEdit.getText()))
    refreshListAdapter()
  end)

  filterRow.addView(allButton, LinearLayout.LayoutParams(0, -2, 1))
  filterRow.addView(favoriteButton, LinearLayout.LayoutParams(0, -2, 1))
  filterRow.addView(recentButton, LinearLayout.LayoutParams(0, -2, 1))
  root.addView(filterRow)

  local filterRow2 = LinearLayout(context)
  filterRow2.setOrientation(LinearLayout.HORIZONTAL)

  local refreshButton = createButton(T("refresh"), function()
    scanAudioFiles()
    filterAudio(tostring(searchEdit.getText()))
    refreshListAdapter()
    toast(T("refresh"))
  end)

  local settingsButton = createButton(T("settings"), function()
    showSettings()
  end)

  local aboutButton = createButton(T("about"), function()
    showAbout()
  end)

  filterRow2.addView(refreshButton, LinearLayout.LayoutParams(0, -2, 1))
  filterRow2.addView(settingsButton, LinearLayout.LayoutParams(0, -2, 1))
  filterRow2.addView(aboutButton, LinearLayout.LayoutParams(0, -2, 1))
  root.addView(filterRow2)

  listView = ListView(context)

  listView.setOnItemClickListener{
    onItemClick = function(parent, view, position, id)
      playItem(position + 1)
    end
  }

  listView.setOnItemLongClickListener{
    onItemLongClick = function(parent, view, position, id)
      showItemMenu(visibleList[position + 1])
      return true
    end
  }

  root.addView(listView, LinearLayout.LayoutParams(-1, 0, 1))

  local bottomRow = LinearLayout(context)
  bottomRow.setOrientation(LinearLayout.HORIZONTAL)

  local closeButton = createButton(T("exit"), function()
    savePositionForPath(currentPath)
    releasePlayer()
    abandonAudioFocus()
    releaseWakeLock()
    cancelSleepTimer()

    pcall(function()
      if mainDialog ~= nil then
        mainDialog.dismiss()
      end
    end)
  end)

  bottomRow.addView(closeButton, LinearLayout.LayoutParams(-1, -2))
  root.addView(bottomRow)

  mainDialog = AlertDialog.Builder(context)
    .setTitle(APP_NAME)
    .setView(root)
    .create()

  mainDialog.setOnDismissListener{
    onDismiss = function()
      stopProgressUpdater()
    end
  }

  showDialogSafely(mainDialog)

  filterAudio("")
  refreshListAdapter()
  updateNowPlaying()
  updateButtons()
end

-- =====================================================================
-- STARTUP
-- =====================================================================

pcall(function()
  if mainDialog ~= nil then
    mainDialog.dismiss()
  end
end)

showMainDialog()